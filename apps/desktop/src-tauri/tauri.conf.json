{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cove",
  "version": "0.3.0",
  "identifier": "app.cove.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cove",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' cove-plugin: http://cove-plugin.localhost; worker-src 'self' blob:; img-src 'self' asset: data: cove-img: http://cove-img.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/cove-recommender",
      "binaries/cove-connectors"
    ],
    "category": "Game",
    "shortDescription": "Ein ruhiger Launcher für alle deine Spiele",
    "publisher": "Cove",
    "homepage": "https://github.com/bjoernhar10/Cove-Launcher",
    "license": "MIT"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzMUFGOTdFQ0FCMkI3MzUKUldRMXQ3TEtmdmthc3pLTThYWmIydWpWb2E1S1VIYllXVUlreTFwR2pVeU5IM0JCQWw3MjRpRzMK",
      "endpoints": [
        "https://github.com/bjoernhar10/Cove-Launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

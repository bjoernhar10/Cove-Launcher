<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Cove.Connectors</RootNamespace>
    <AssemblyName>cove-connectors</AssemblyName>
    <Version>0.1.0</Version>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cove.Connectors.Tests" />
    <EmbeddedResource Include="Config/connectors.json" LogicalName="Cove.Connectors.Config.connectors.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="9.0.23" />
  </ItemGroup>

  <!-- Cross-compiling (e.g. Apple Silicon on an Intel Mac) needs the compiler for the build machine too;
       scripts/build_sidecar.mjs sets CoveHostRid then. -->
  <ItemGroup Condition="'$(CoveHostRid)' != ''">
    <PackageReference Include="runtime.$(CoveHostRid).Microsoft.DotNet.ILCompiler" Version="9.0.23" />
  </ItemGroup>

</Project>
